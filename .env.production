# Production build config. Vite loads this automatically for `npm run build`.
# Local dev is unaffected — `npm run dev` uses .env (localhost).
#
# The admin panel talks to BOTH backends:
#   VITE_API_BASE        -> admin backend  (was localhost:8081)
#   VITE_CLIENT_API_BASE -> storefront backend (was localhost:8080)
VITE_API_BASE=https://admin-api.maayaawear.com
VITE_CLIENT_API_BASE=https://api.maayaawear.com
