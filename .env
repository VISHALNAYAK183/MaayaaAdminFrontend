# Dev config, loaded by `npm run dev`.
#
# The backends run on AWS — there is no local backend to point at — so dev
# targets the deployed hosts. Note this means local dev reads AND WRITES live
# production data.
#
# The admin panel talks to BOTH backends:
#   VITE_API_BASE        -> admin backend
#   VITE_CLIENT_API_BASE -> storefront backend
#
# Run the dev server on port 5173 or 5174: both backends' CORS allow-lists only
# include those two localhost origins, so any other port is blocked.
#
# To override on your own machine, create .env.local (gitignored).
VITE_API_BASE=https://admin-api.maayaawear.com
VITE_CLIENT_API_BASE=https://api.maayaawear.com
